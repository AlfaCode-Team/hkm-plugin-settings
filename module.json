{
    "name": "settings",
    "version": "1.1.0",
    "kernel": "^1.2",
    "solves": "tenant.settings",
    "type": "module",

    "requires": ["database.management", "validation.rules"],
    "exposes": ["Plugins\\Settings\\API\\Contracts\\SettingsServiceContract"],

    "routePrefix": "/api/settings",
    "routeFilters": ["auth"],
    "routes": [
        { "method": "GET",    "path": "/company",         "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@company" },
        { "method": "PUT",    "path": "/company",         "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@saveCompany" },
        { "method": "POST",   "path": "/company/logo",    "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@uploadCompanyLogo",  "requires": ["storage.local"] },
        { "method": "DELETE", "path": "/company/logo",    "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@removeCompanyLogo",  "requires": ["storage.local"] },
        { "method": "GET",    "path": "/contact",         "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@contact" },
        { "method": "PUT",    "path": "/contact",         "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@saveContact" },
        { "method": "GET",    "path": "/email",           "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@email" },
        { "method": "PUT",    "path": "/email",           "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@saveEmail" },
        { "method": "GET",    "path": "/email-providers", "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@emailProviders" },
        { "method": "PUT",    "path": "/email-providers", "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@saveEmailProviders" },
        { "method": "GET",    "path": "/system",          "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@system" },
        { "method": "PUT",    "path": "/system",          "handler": "Plugins\\Settings\\Infrastructure\\Http\\SettingsController@saveSystem" }
    ],

    "emits":   [],
    "listens": [],

    "config": []
}
